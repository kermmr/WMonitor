<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>WMonitor</AssemblyName>
    <RootNamespace>WMonitor</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>0.32.0</Version>
    <AssemblyVersion>0.32.0.0</AssemblyVersion>
    <FileVersion>0.32.0.0</FileVersion>
    <Product>WMonitor</Product>
    <AssemblyTitle>WMonitor</AssemblyTitle>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>embedded</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- 测试项目在 tests/ 下，不参与主程序编译（默认通配会把根下所有 .cs 收进来）；
       Updater 是 internal，经 InternalsVisibleTo 给测试项目做单测 -->
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <InternalsVisibleTo Include="WMonitor.Tests" />
  </ItemGroup>

</Project>
